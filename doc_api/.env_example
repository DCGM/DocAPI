# =============================================================================
# Database
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_api_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Allow automatic schema migrations.
DATABASE_ALLOW_UPDATE=false

# =============================================================================
# Application
# =============================================================================

# Uploaded files, results and logs; match the volume mount in compose.yml.
BASE_DIR=/app/doc_api_data
APP_BASE_URL=https://docapi.example.com
# URL prefix, e.g. /subpath; empty for the root URL.
APP_URL_ROOT=""

# Admin email identity.
ADMIN_SERVER_NAME=pc-doc-api-admin-01

# Authentication --------------------------------------------------------------

# API key format: {KEY_PREFIX}.{KEY_ID}.secret
KEY_PREFIX=doc-api
# Replace both secrets in production.
ADMIN_KEY=${KEY_PREFIX}.adminkeykid.changemeadminkeysecret12345
HMAC_SECRET=changemehmacsecret12345

# Public name in the UI, authentication responses and emails.
SERVER_NAME=DocAPI
CONTACT_TO_GET_NEW_KEY=admin@pc-doc-api-01.cz

# =============================================================================
# Job processing
# =============================================================================

# Checker intervals in seconds (positive integers).
JOB_READINESS_CHECK_INTERVAL_SECONDS=5
JOB_LEASE_CHECK_INTERVAL_SECONDS=5

# Zero disables lease expiration; ERROR jobs still retry.
# Positive timeouts expire after timeout + grace without worker updates.
JOB_TIMEOUT_SECONDS=0
JOB_TIMEOUT_GRACE_SECONDS=10
# Total processing attempts; exhausted jobs become FAILED.
JOB_MAX_ATTEMPTS=3

# Input cleanup ---------------------------------------------------------------

# Cleanup applies to DONE/FAILED jobs; job records are retained.
DELETE_JOB_INPUTS_ON_COMPLETION=false
# Seconds from finished_date; 0 means immediate cleanup.
# Positive retention keeps jobs without finished_date.
INPUT_RETENTION_SECONDS=0

# Also delete image rows after input cleanup; job responses then have images: [].
# Recover required-input totals from image_count + requirements, or job definitions.
# Definitions retain names, order and URLs; hashes, image UUIDs and upload flags are lost.
# With linked inputs, actual API-upload totals cannot be reconstructed.
DELETE_JOB_IMAGE_RECORDS_WITH_INPUTS=false

# Output cleanup --------------------------------------------------------------

# Delete selected ZIPs for DONE/FAILED jobs; job records are retained.
DELETE_JOB_OUTPUTS=false
# Seconds from finished_date; 604800 = 7 days, 0 = immediate cleanup.
# Positive retention keeps jobs without finished_date.
OUTPUT_RETENTION_SECONDS=604800
# Comma-separated: results, artifacts, or both.
OUTPUT_CLEANUP_TARGETS=results,artifacts

# Cleanup schedule ------------------------------------------------------------

# Run at startup, then every N seconds (positive integer).
# Each target records *_deleted_at after removal or finding files already missing.
CLEANUP_INTERVAL_SECONDS=60

# =============================================================================
# Input and file validation
# =============================================================================

# Filename extensions ---------------------------------------------------------

# Require a nonempty extension unless an allowlist overrides this setting.
REQUIRE_IMAGE_EXTENSION=false
# Case-insensitive list; accepts leading dots. Empty = no allowlist.
# Example: .jpg,.jpeg,.png,.tif,.tiff
ALLOWED_IMAGE_EXTENSIONS=

# Uploaded files --------------------------------------------------------------

# XML must always parse and images must always decode with OpenCV.
RESULT_ZIP_VALIDATION=true
ARTIFACTS_ZIP_VALIDATION=true
ENGINE_FILES_ZIP_VALIDATION=true

ALTO_VALIDATE_ROOT=true
ALTO_VALIDATE_NAMESPACE=false
ALTO_VALIDATE_HAS_LAYOUT=false
ALTO_VALIDATE_HAS_PAGE=false
ALTO_VALIDATE_HAS_TEXT=false

PAGE_VALIDATE_ROOT=true
PAGE_VALIDATE_NAMESPACE=false
PAGE_VALIDATE_HAS_PAGE=false
PAGE_VALIDATE_HAS_TEXT=false

# =============================================================================
# Mailing
# =============================================================================

# Shared subject placeholders -------------------------------------------------

# Job subjects: {server_name}, {admin_server_name}, {state}, {state_upper},
# {job_id}, {job_id_short}, {image_count}, {attempt}, {engine_name},
# {engine_version}, {owner_label}. Omit unused fields; Python format specs work.
# state = done/failed; state_upper = DONE/FAILED; job_id_short = first 8 characters.
# attempt is 1-based (0 if never leased); missing engine/owner values are empty.
# Server-error subjects accept only {server_name} and {admin_server_name}.

# Internal: server errors and admin job reports -------------------------------

# Server and sender address are required; password depends on SMTP setup.
# INTERNAL_MAIL_SERVER=must be set for mailing to work
INTERNAL_MAIL_PORT=25
INTERNAL_MAIL_SENDER_NAME=${ADMIN_SERVER_NAME}
# INTERNAL_MAIL_SENDER_MAIL=must be set for mailing to work
# INTERNAL_MAIL_PASSWORD=optional, depends on the SMTP server
# Comma-separated recipients; empty = no admin recipients.
INTERNAL_MAIL_RECEIVER_MAILS=
# Per-subject hourly limit; 0 = unlimited.
INTERNAL_MAIL_FLOOD_LEVEL=10
INTERNAL_ERROR_MAIL_SUBJECT_TEMPLATE="[{admin_server_name}] INTERNAL SERVER ERROR"
ADMIN_JOB_MAIL_SUBJECT_TEMPLATE="[{admin_server_name}] {state_upper} job {job_id_short} ({owner_label})"

# External: user job reports ---------------------------------------------------

# Enable email/email_notifications on owner keys through the admin API.
# Server and sender address are required; password depends on SMTP setup.
# EXTERNAL_MAIL_SERVER=must be set for owner notifications
EXTERNAL_MAIL_PORT=25
EXTERNAL_MAIL_SENDER_NAME=${SERVER_NAME}
# EXTERNAL_MAIL_SENDER_MAIL=must be set for owner notifications
# EXTERNAL_MAIL_PASSWORD=optional, depends on the SMTP server
# Per-subject hourly limit; 0 = unlimited.
EXTERNAL_MAIL_FLOOD_LEVEL=0
USER_JOB_MAIL_SUBJECT_TEMPLATE="[{server_name}] {state_upper} job {job_id_short}"

# Job notification policy (user and admin reports) -----------------------------

# Mail nonempty final reports for DONE/FAILED jobs; never fall back to process logs.
# Delivery status and retries persist in the DB; server-error emails do not retry.
# Job flood limits apply per channel/recipient/subject/hour within each API process.
JOB_MAIL_CHECK_INTERVAL_SECONDS=5
# Total SMTP attempts, including the first.
JOB_MAIL_MAX_ATTEMPTS=3
# Initial retry delay in seconds; doubles after failures, capped at one day.
JOB_MAIL_RETRY_DELAY_SECONDS=60

# =============================================================================
# Logging
# =============================================================================

# Files are stored in ${BASE_DIR}/logs/.
LOGGING_FILE_LEVEL=DEBUG
LOGGING_CONSOLE_LEVEL=INFO

# =============================================================================
# Swagger documentation
# =============================================================================

# Visibility only; endpoint access is unchanged. Descriptions/examples: compose.yml.
SHOW_SECTIONS="User, Worker, Admin"
SHOW_GET_ENGINES=true
SHOW_PUT_IMAGE=true
SHOW_PUT_ALTO=true
SHOW_PUT_PAGE=true
SHOW_PUT_METADATA=true
