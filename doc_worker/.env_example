# Settings for a worker built on DocWorkerWrapper, read by doc_worker/config.py.
# Each line shows the default; an empty value means not set.

# --- Worker ---
# The worker's name; empty takes the label of the worker's API key from DocAPI
# at startup. Set it only to override that label, e.g. "OCR worker prod". The name
# appears in the subject and the "worker" line of every email the worker sends, and
# is sent as the User-Agent of its requests, so the DocAPI proxy logs show which
# worker made a request.
WORKER_IDENTITY=

# --- DocAPI connection ---
# The DocAPI base URL. Required.
API_URL=
# The worker's API key, or a file holding it (preferred). Exactly one is required.
WORKER_KEY=
WORKER_KEY_FILE=
# Seconds to connect, and to wait for the next bytes of a response.
API_CONNECT_TIMEOUT_SECONDS=10
API_READ_TIMEOUT_SECONDS=300

# --- Directories ---
# BASE_DIR holds jobs/ and engines/; JOBS_DIR and ENGINES_DIR override them.
# Either BASE_DIR, or both JOBS_DIR and ENGINES_DIR, are required.
BASE_DIR=
JOBS_DIR=
ENGINES_DIR=
# Delete a job's directory once its successful result has been reported to DocAPI,
# so finished jobs do not fill the disk; failed jobs are kept for inspection.
CLEANUP_JOB_DIR=false
# Delete the earlier download of an engine when it is downloaded again because its
# files changed on DocAPI, so only the current copy stays on disk.
CLEANUP_OLD_ENGINES=false
# A JSONL file recording every job attempt on disk; ALIVE emails include its statistics.
# Empty keeps no history.
JOB_HISTORY_PATH=

# --- Polling and inputs ---
# Seconds to wait before asking DocAPI for a job again after it had none; at least 1,
# so an idle worker does not flood DocAPI with requests.
POLLING_INTERVAL=5
# Prefer normal API uploads when both sources exist, unless enabled.
PREFER_IMAGE_URL=false
PREFER_ALTO_URL=false
PREFER_PAGE_URL=false

# --- Worker mail ---
# The worker emails its own state: failures (FAILURE), DocAPI outages (DISCONNECTED,
# STILL DISCONNECTED, RECONNECTED) and regular status reports (ALIVE, see below).
# Without MAIL_SERVER it sends no emails, and the other mail settings must stay empty;
# with it, MAIL_SENDER_MAIL and MAIL_RECEIVER_MAILS are required. Emails about jobs come
# from DocAPI, not the worker.
# Connection: where and how to connect.
MAIL_SERVER=
MAIL_PORT=25
# auto, ssl, starttls or none; auto is ssl with a password, none without.
MAIL_SECURITY=auto
# A PEM file of trusted CA certificates; empty trusts the system's.
MAIL_CA_FILE=
MAIL_TIMEOUT_SECONDS=60
# Sender: who the emails are from. MAIL_SENDER_MAIL is required with MAIL_SERVER.
MAIL_SENDER_MAIL=
MAIL_SENDER_NAME=
# Login: used only with a password; the login name is MAIL_SENDER_MAIL by default.
MAIL_USERNAME=
MAIL_PASSWORD=
# Receivers: who gets the worker's emails, comma separated; each gets a separate email.
MAIL_RECEIVER_MAILS=
# Limits: how many emails may go out per sliding window; 0 turns a limit off.
# At most this many emails with one subject to one receiver per window.
MAIL_SEND_RECEIVER_LIMIT=10
MAIL_SEND_RECEIVER_WINDOW_SECONDS=3600
# At most this many emails in total per window, to all receivers together.
MAIL_SEND_SERVER_LIMIT=100
MAIL_SEND_SERVER_WINDOW_SECONDS=3600
# The host in the worker's emails; empty uses the host name.
WORKER_HOSTNAME=
# The subject of every email the worker sends, a Python format string with {identity},
# {hostname}, {time} (UTC datetime, e.g. {time:%Y-%m-%d}) and {status}, the kind of email:
# FAILURE when the worker fails, DISCONNECTED, STILL DISCONNECTED or
# RECONNECTED for DocAPI outages and ALIVE for health mail (see their sections below).
MAIL_SUBJECT=[{identity}] {status} ({hostname})

# --- DocAPI outages ---
# Emails with the subject statuses DISCONNECTED, STILL DISCONNECTED and RECONNECTED,
# sent when mail is set up and DocAPI cannot be reached.
# DISCONNECTED once DocAPI has been unreachable this long while the worker is idle;
# an outage during a job is mailed at once.
DISCONNECTED_GRACE_SECONDS=60
# A STILL DISCONNECTED reminder this often while DocAPI stays unreachable; RECONNECTED
# follows when it is back.
DISCONNECTED_MAIL_INTERVAL_SECONDS=3600

# --- Health mail ---
# Emails with the subject status ALIVE, sent when mail is set up (MAIL_SERVER and
# MAIL_RECEIVER_MAILS): one at startup, then one every interval, with the worker's
# uptime, its last and active job and, with JOB_HISTORY_PATH, its job statistics.
# Send an ALIVE email when the worker starts.
MAIL_STARTUP=true
# Seconds between the ALIVE emails; the default is one day (86400), 0 sends none.
MAIL_ALIVE_INTERVAL_SECONDS=86400

# --- Error messages ---
# The texts a job gets when the worker fails at one of its steps: _LOG is the technical
# report for admins (diagnostics are appended to it), _LOG_USER the report for the job's
# owner. Empty keeps the text shown. ERROR_DOWNLOAD_INPUT_* may use {kind} (image, ALTO
# or PAGE) and {filename}.
ERROR_REQUEST_JOB_LOG=Failed to request job
ERROR_REQUEST_JOB_LOG_USER=Failed to request job
ERROR_REQUEST_JOB_LEASE_LOG=Failed to request job lease
ERROR_REQUEST_JOB_LEASE_LOG_USER=Failed to request job lease
ERROR_GET_JOB_DETAILS_LOG=Failed to get job details
ERROR_GET_JOB_DETAILS_LOG_USER=Failed to get job details
ERROR_NO_CURRENT_JOB_LOG=No current job set
ERROR_NO_CURRENT_JOB_LOG_USER=No current job set
ERROR_PREPARE_ENGINE_FILES_LOG=Failed to download or prepare engine files
ERROR_PREPARE_ENGINE_FILES_LOG_USER=Failed to download or prepare engine files
ERROR_DOWNLOAD_ENGINE_FILES_LOG=Failed to download engine files
ERROR_DOWNLOAD_ENGINE_FILES_LOG_USER=Failed to download engine files
ERROR_DOWNLOAD_JOB_DATA_LOG=Failed to download job data from server
ERROR_DOWNLOAD_JOB_DATA_LOG_USER=Failed to download job data from server
ERROR_DOWNLOAD_INPUT_LOG=Failed to download {kind} for {filename}
ERROR_DOWNLOAD_INPUT_LOG_USER=Failed to download {kind} for {filename}
ERROR_DOWNLOAD_META_JSON_LOG=Failed to download meta JSON
ERROR_DOWNLOAD_META_JSON_LOG_USER=Failed to download meta JSON
ERROR_CREATE_JOB_WORKSPACE_LOG=Unable to create job workspace directory
ERROR_CREATE_JOB_WORKSPACE_LOG_USER=Unable to create job workspace directory
ERROR_JOB_DATA_PATH_LOG=Failed to get job data path
ERROR_JOB_DATA_PATH_LOG_USER=Failed to get job data path
ERROR_PROCESS_JOB_LOG=Processing failed due to an internal error
ERROR_PROCESS_JOB_LOG_USER=Processing failed due to an internal error
ERROR_PACKAGE_RESULTS_LOG=Failed to package processing results
ERROR_PACKAGE_RESULTS_LOG_USER=Failed to package processing results
ERROR_NO_JOB_FOR_RESULT_UPLOAD_LOG=No current job to upload results for
ERROR_NO_JOB_FOR_RESULT_UPLOAD_LOG_USER=No current job to upload results for
ERROR_UPLOAD_RESULTS_LOG=Failed to upload results
ERROR_UPLOAD_RESULTS_LOG_USER=Failed to upload results
ERROR_UPLOAD_RESULTS_TO_SERVER_LOG=Failed to upload results to server
ERROR_UPLOAD_RESULTS_TO_SERVER_LOG_USER=Failed to upload results to server
ERROR_UNEXPECTED_PROCESSING_LOG=An unexpected error occurred during processing
ERROR_UNEXPECTED_PROCESSING_LOG_USER=An unexpected error occurred during processing
